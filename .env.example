# Acople - Environment Configuration
# Copy this file to .env and adjust values.

# Agent to use (e.g., claude, opencode, gemini, codex)
ACOPLE_AGENT=claude

# Max concurrent requests (default: 5)
ACOPLE_MAX_CONCURRENT=5

# Enable/disable persistent session memory
# Set to "false" to disable (stateless mode)
ACOPLE_SESSIONS=true

# API key for authenticating requests to the server
ACOPLE_API_KEY=

# CORS origins (comma-separated, default: http://localhost:*)
ACOPLE_CORS_ORIGINS=http://localhost:*

# Default working directory for agents when the client no especifica cwd.
# Si no se define, se usa el directorio donde corre el servidor (Path.cwd()).
# Ejemplo: ACOPLE_DEFAULT_CWD=C:\Users\jorge\proyectos
ACOPLE_DEFAULT_CWD=

# OpenAI API key (required for image generation features)
OPENAI_API_KEY=
